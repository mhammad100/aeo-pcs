PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/aeo-pcs

ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
PERPLEXITY_API_KEY=your_perplexity_api_key_here

PUBLIC_SITE_URL=http://localhost:3000
ADMIN_SITE_URL=http://localhost:5173

JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

SIGNUP_ENABLED=true

# One-time lifetime free visibility runs for new/unsubscribed users (not monthly).
FREE_VISIBILITY_RUNS=1

# Billing: leave keys empty (or BILLING_STUB=true) for local stub subscribe.
# With keys set, checkout uses Razorpay Subscriptions (set BILLING_STUB=false to force).
BILLING_STUB=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=